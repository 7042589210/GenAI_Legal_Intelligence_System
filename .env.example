# Model Keys
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./tata_legal.db
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Vector Database
DB_CHROMA_PATH=vectorstore/db_chroma

# OCR Configuration
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=/usr/bin/tesseract

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8501,http://localhost:3000,https://your-frontend-domain.com

# Model Settings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIMENSION=768
LLM_MODEL=llama3-70b-8192
LLM_SCAN_MODEL=llama3-70b-8192
LLM_REASONING_MODEL=llama3-70b-8192
